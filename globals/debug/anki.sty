\newif\ifshownotes
\def\prefix{}
\def\topic{}

\newcommand{\ankishow}{
 \shownotestrue
}

\newcommand{\ankiprefix}[1]{
 \def\prefix{#1}
}

\newcommand{\ankitopic}[1]{
 \def\topic{#1}
}

\newcommand{\ankinote}[3]{%
 \if\relax\detokenize\expandafter{\prefix}\relax%
  \errmessage{Set an Anki prefix}
 \fi%
 \ifshownotes%
  \ifcsname ankicardid#1\endcsname%
   \errmessage{Reused anki id: #1}
  \fi%
  \ifcsname ankicardfront#2\endcsname%
   \errmessage{Reused anki front: #2}
  \fi%
  \expandafter\def\csname ankicardid#1\endcsname{true}%
  \expandafter\def\csname ankicardfront#2\endcsname{true}%
  \noindent \pwriteankinote{\prefix:#1}{\topic{} #2}{#3} \newline
 \fi%
}

\newcommand{\pwriteankinote}[3]{%
 \texttt{[#1]} #2: #3
}